    "History is kept only on this Mac, up to %lld queries per connection.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ السجل على هذا الـ Mac فقط، حتى %lld استعلامًا لكل اتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf wird nur auf diesem Mac gespeichert, bis zu %lld Abfragen pro Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial se guarda solo en este Mac, hasta %lld consultas por conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique n'est conservé que sur ce Mac, jusqu'à %lld requêtes par connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास केवल इस Mac पर रखा जाता है, प्रति कनेक्शन अधिकतम %lld क्वेरी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat hanya disimpan di Mac ini, hingga %lld query per koneksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia viene conservata solo su questo Mac, fino a %lld query per connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴はこの Mac にのみ保存され、接続ごとに最大 %lld 件です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 이 Mac에만 저장되며 연결당 최대 %lld개의 쿼리를 보관합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia jest przechowywana tylko na tym Macu, maksymalnie %lld zapytań na połączenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico é mantido apenas neste Mac, com até %lld consultas por conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История хранится только на этом Mac, до %lld запросов на подключение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติจะถูกเก็บไว้บน Mac เครื่องนี้เท่านั้น สูงสุด %lld คำสั่งต่อการเชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş yalnızca bu Mac'te, bağlantı başına en fazla %lld sorgu olarak saklanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử chỉ được lưu trên Mac này, tối đa %lld câu lệnh mỗi kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录仅保存在此 Mac 上，每个连接最多 %lld 条查询。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄僅保存在此 Mac 上，每個連線最多 %lld 筆查詢。"
          }
        }
      }
    },
    "History: recent queries run on this connection — the selected query is appended to the editor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السجل: الاستعلامات الأخيرة التي تم تشغيلها على هذا الاتصال — يُضاف الاستعلام المحدد إلى المحرر"
          }
        },
        "de": {
          "stringUnit": {
