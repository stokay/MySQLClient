          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프록시가 %lld초 이내에 응답하지 않았습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer proxy nie odpowiedział w ciągu %lld sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O proxy não respondeu em %lld segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокси-сервер не ответил в течение %lld секунд."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร็อกซีไม่ตอบกลับภายใน %lld วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy %lld saniye içinde yanıt vermedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy không phản hồi trong vòng %lld giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理服务器未在 %lld 秒内响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理伺服器未在 %lld 秒內回應。"
          }
        }
      }
    },
    "The proxy refused the connection to %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الوكيل الاتصال بـ %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Proxy hat die Verbindung zu %@ abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proxy rechazó la conexión con %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proxy a refusé la connexion à %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉक्सी ने %@ से कनेक्शन अस्वीकार कर दिया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy menolak koneksi ke %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il proxy ha rifiutato la connessione a %@."
          }
        },
        "ja": {
          "stringUnit": {
