    "DROP %@ deletes it permanently and cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ löscht es dauerhaft, dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ lo elimina permanentemente y no se puede deshacer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ इसे स्थायी रूप से हटा देता है और इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ usuwa go trwale i nie można tego cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ удаляет его безвозвратно, отменить это действие нельзя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ kalıcı olarak siler, geri alınamaz."
          }
        }
      }
    },
    "DROP TABLE deletes the table and its structure permanently and cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE löscht die Tabelle und ihre Struktur dauerhaft, dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE elimina la tabla y su estructura permanentemente y no se puede deshacer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE टेबल और उसकी संरचना को स्थायी रूप से हटा देता है और इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE trwale usuwa tabelę i jej strukturę — nie można tego cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE безвозвратно удаляет таблицу и её структуру, отменить это действие нельзя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE tabloyu yapısıyla birlikte kalıcı olarak siler, geri alınamaz."
          }
        }
      }
    },
    "DROP VIEW deletes the view permanently and cannot be undone.": {
