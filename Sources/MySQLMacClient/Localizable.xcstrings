    "Finished with %lld failed statements, listed below. Every other statement was restored.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتملت مع %lld عبارة فاشلة مدرجة أدناه. تمت استعادة كل العبارات الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %lld fehlgeschlagenen Anweisungen beendet (siehe unten). Alle anderen Anweisungen wurden wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminó con %lld sentencias fallidas, listadas abajo. Todas las demás sentencias se restauraron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé avec %lld instructions en échec, listées ci-dessous. Toutes les autres instructions ont été restaurées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld विफल स्टेटमेंट के साथ पूरा हुआ, जो नीचे दिए गए हैं। बाकी सभी स्टेटमेंट रीस्टोर हो गए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai dengan %lld pernyataan gagal, tercantum di bawah. Semua pernyataan lain telah dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminato con %lld istruzioni non riuscite, elencate qui sotto. Tutte le altre istruzioni sono state ripristinate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の文が失敗して終了しました（下に一覧）。その他の文はすべて復元されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패한 문 %lld개와 함께 완료되었습니다(아래 목록). 나머지 문은 모두 복원되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończono z nieudanymi instrukcjami (%lld), wymienionymi poniżej. Wszystkie pozostałe instrukcje zostały przywrócone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluído com %lld instruções com falha, listadas abaixo. Todas as outras instruções foram restauradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершено с неудачными операторами (%lld), они перечислены ниже. Все остальные операторы восстановлены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสร็จสิ้นโดยมี %lld คำสั่งที่ล้มเหลว ตามรายการด้านล่าง คำสั่งอื่นทั้งหมดถูกกู้คืนแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld başarısız ifadeyle tamamlandı, aşağıda listelendi. Diğer tüm ifadeler geri yüklendi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tất với %lld câu lệnh lỗi, liệt kê bên dưới. Mọi câu lệnh khác đã được khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成，有 %lld 条语句失败（见下方列表）。其他所有语句均已恢复。"
          }
