    "You've sent several messages today. Please try again tomorrow.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد أرسلت عدة رسائل اليوم. يُرجى المحاولة مرة أخرى غدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben heute bereits mehrere Nachrichten gesendet. Bitte versuchen Sie es morgen erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy ya has enviado varios mensajes. Inténtalo de nuevo mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà envoyé plusieurs messages aujourd'hui. Veuillez réessayer demain."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप आज कई संदेश भेज चुके हैं। कृपया कल फिर प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah mengirim beberapa pesan hari ini. Silakan coba lagi besok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi hai già inviato diversi messaggi. Riprova domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日はすでに複数のメッセージを送信しています。明日もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 이미 여러 개의 메시지를 보냈습니다. 내일 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłano dziś już kilka wiadomości. Spróbuj ponownie jutro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já enviou várias mensagens hoje. Tente novamente amanhã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня вы уже отправили несколько сообщений. Повторите попытку завтра."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้คุณส่งข้อความไปหลายข้อความแล้ว โปรดลองอีกครั้งในวันพรุ่งนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün birkaç mesaj gönderdiniz. Lütfen yarın tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay bạn đã gửi nhiều tin nhắn. Vui lòng thử lại vào ngày mai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天已发送多条消息。请明天再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天已傳送多則訊息。請明天再試。"
          }
        }
      }
    },
