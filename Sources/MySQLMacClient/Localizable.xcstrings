    "DROP TABLE deletes the table and its structure permanently and cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف DROP TABLE الجدول وبنيته بشكل نهائي ولا يمكن التراجع عنه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE löscht die Tabelle und ihre Struktur dauerhaft, dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE elimina la tabla y su estructura permanentemente y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE supprime définitivement la table et sa structure ; cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE टेबल और उसकी संरचना को स्थायी रूप से हटा देता है और इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE menghapus tabel beserta strukturnya secara permanen dan tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE elimina definitivamente la tabella e la sua struttura e non può essere annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE はテーブルとその構造を完全に削除し、元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE는 테이블과 구조를 영구적으로 삭제하며 되돌릴 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE trwale usuwa tabelę i jej strukturę — nie można tego cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE exclui a tabela e sua estrutura permanentemente e não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE безвозвратно удаляет таблицу и её структуру, отменить это действие нельзя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE จะลบตารางและโครงสร้างของตารางอย่างถาวรและไม่สามารถย้อนกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE tabloyu yapısıyla birlikte kalıcı olarak siler, geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE sẽ xóa vĩnh viễn bảng cùng cấu trúc của nó và không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE 会永久删除表及其结构，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TABLE 會永久刪除表格及其結構，且無法復原。"
          }
        }
      }
    },
    "DROP TRIGGER deletes it permanently and cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف DROP TRIGGER بشكل نهائي ولا يمكن التراجع عنه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER löscht es dauerhaft, dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER lo elimina permanentemente y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER le supprime définitivement et cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER इसे स्थायी रूप से हटा देता है और इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER menghapusnya secara permanen dan tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER lo elimina definitivamente e non può essere annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER は完全に削除され、元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER는 영구적으로 삭제되며 되돌릴 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER usuwa go trwale i nie można tego cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER o exclui permanentemente e não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER удаляет его безвозвратно, отменить это действие нельзя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER จะลบอย่างถาวรและไม่สามารถย้อนกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER kalıcı olarak siler, geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER sẽ xóa vĩnh viễn và không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP TRIGGER 会永久删除它，且无法撤销。"
