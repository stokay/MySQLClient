    "No mysql or mariadb client was found. Choose one in Settings ▸ General.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على عميل mysql أو mariadb. اختر أحدهما في الإعدادات ◂ عام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weder ein mysql- noch ein mariadb-Client wurde gefunden. Wählen Sie unter Einstellungen ▸ Allgemein einen aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún cliente mysql ni mariadb. Selecciona uno en Ajustes ▸ General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun client mysql ou mariadb n'a été trouvé. Choisissez-en un dans Réglages ▸ Général."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "mysql या mariadb क्लाइंट नहीं मिला। सेटिंग्स ▸ सामान्य में इनमें से कोई एक चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klien mysql atau mariadb tidak ditemukan. Pilih salah satunya di Pengaturan ▸ Umum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato trovato alcun client mysql o mariadb. Scegline uno in Impostazioni ▸ Generale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mysql クライアントも mariadb クライアントも見つかりませんでした。「設定 ▸ 一般」で選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "mysql 또는 mariadb 클라이언트를 찾을 수 없습니다. 설정 ▸ 일반에서 하나를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono ani klienta mysql, ani mariadb. Wybierz jeden z nich w oknie Ustawienia ▸ Ogólne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum cliente mysql ou mariadb foi encontrado. Escolha um em Ajustes ▸ Geral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не найден ни клиент mysql, ни клиент mariadb. Выберите один из них в разделе «Настройки ▸ Общие»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบไคลเอนต์ mysql หรือ mariadb โปรดเลือกไคลเอนต์ที่ การตั้งค่า ▸ ทั่วไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "mysql veya mariadb istemcisi bulunamadı. Ayarlar ▸ Genel'den birini seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy trình khách mysql hoặc mariadb. Hãy chọn một trình khách trong Cài đặt ▸ Chung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 mysql 或 mariadb 客户端。请在“设置 ▸ 通用”中选择一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 mysql 或 mariadb 用戶端。請在「設定 ▸ 一般」中選擇一個。"
          }
        }
      }
    },
