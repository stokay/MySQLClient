    "Permanently delete the %@ '%@'?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف %1$@ '%2$@' نهائيًا؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ „%@“ dauerhaft löschen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@ \"%@\" permanentemente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer définitivement %1$@ « %2$@ » ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ '%2$@' को स्थायी रूप से हटाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus %@ '%@' secara permanen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare definitivamente %1$@ '%2$@'?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ '%2$@' を完全に削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ '%2$@'을(를) 영구적으로 삭제하시겠습니까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usunąć %1$@ „%2$@”?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir permanentemente %1$@ '%2$@'?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %1$@ «%2$@» безвозвратно?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ %@ '%@' อย่างถาวรหรือไม่?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' '%@' tamamen silinsin mi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa vĩnh viễn %@ '%@'?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除 %1$@ “%2$@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除 %1$@「%2$@」？"
          }
        }
      }
    },
