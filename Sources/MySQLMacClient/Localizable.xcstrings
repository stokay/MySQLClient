        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement « %@ » n'existe pas sur le serveur auquel vous êtes connecté. Remplacez-le par un classement pris en charge par ce serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Collation '%@' उस सर्वर पर मौजूद नहीं है जिससे आप जुड़े हैं। इसे इस सर्वर द्वारा समर्थित किसी collation से बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Collation '%@' tidak ada di server yang Anda sambungkan. Ganti dengan collation yang didukung server ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La collation '%@' non esiste sul server a cui sei connesso. Sostituiscila con una supportata da questo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "照合順序 '%@' は接続先のサーバーに存在しません。このサーバーがサポートするものに置き換えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콜레이션 '%@'이(가) 연결된 서버에 존재하지 않습니다. 이 서버가 지원하는 콜레이션으로 바꾸세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porządek sortowania „%@” nie istnieje na serwerze, z którym jesteś połączony. Zastąp go takim, który obsługuje ten serwer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O collation '%@' não existe no servidor ao qual você está conectado. Substitua-o por um suportado por este servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр сортировки «%@» отсутствует на сервере, к которому вы подключены. Замените его на поддерживаемый этим сервером."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มี collation '%@' อยู่บนเซิร์ฟเวอร์ที่คุณเชื่อมต่ออยู่ โปรดเปลี่ยนเป็น collation ที่เซิร์ฟเวอร์นี้รองรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' collation'ı bağlı olduğunuz sunucuda yok. Bu sunucunun desteklediği bir collation ile değiştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
