    "DROP %@ deletes it permanently and cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف DROP %@ بشكل نهائي ولا يمكن التراجع عنه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ löscht es dauerhaft, dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ lo elimina permanentemente y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ le supprime définitivement et cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ इसे स्थायी रूप से हटा देता है और इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ menghapusnya secara permanen dan tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ lo elimina definitivamente e non può essere annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ は完全に削除され、元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@는 영구적으로 삭제되며 되돌릴 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ usuwa go trwale i nie można tego cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ o exclui permanentemente e não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ удаляет его безвозвратно, отменить это действие нельзя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ จะลบอย่างถาวรและไม่สามารถย้อนกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ kalıcı olarak siler, geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ sẽ xóa vĩnh viễn và không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ 会永久删除它，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ 會永久刪除它，且無法復原。"
          }
        }
      }
    },
