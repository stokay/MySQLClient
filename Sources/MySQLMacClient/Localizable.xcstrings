    "DROP %@ deletes it permanently and cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ löscht es dauerhaft, dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ lo elimina permanentemente y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ le supprime définitivement et cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ इसे स्थायी रूप से हटा देता है और इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ は完全に削除され、元に戻せません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ usuwa go trwale i nie można tego cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ o exclui permanentemente e não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ удаляет его безвозвратно, отменить это действие нельзя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ kalıcı olarak siler, geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP %@ 会永久删除它，且无法撤销。"
          }
        }
      }
    },
