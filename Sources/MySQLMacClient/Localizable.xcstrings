          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schema (CREATE TABLE IF NOT EXISTS) und Daten (INSERT INTO) werden zusammen exportiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El esquema (CREATE TABLE IF NOT EXISTS) y los datos (INSERT INTO) se exportan juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schéma (CREATE TABLE IF NOT EXISTS) et les données (INSERT INTO) sont exportés ensemble."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कीमा (CREATE TABLE IF NOT EXISTS) और डेटा (INSERT INTO) एक साथ निर्यात किए जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Skema (CREATE TABLE IF NOT EXISTS) dan data (INSERT INTO) diekspor bersamaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schema (CREATE TABLE IF NOT EXISTS) e i dati (INSERT INTO) vengono esportati insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキーマ (CREATE TABLE IF NOT EXISTS) とデータ (INSERT INTO) は一緒にエクスポートされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스키마(CREATE TABLE IF NOT EXISTS)와 데이터(INSERT INTO)가 함께 내보내집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schemat (CREATE TABLE IF NOT EXISTS) i dane (INSERT INTO) są eksportowane razem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O esquema (CREATE TABLE IF NOT EXISTS) e os dados (INSERT INTO) são exportados juntos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Схема (CREATE TABLE IF NOT EXISTS) и данные (INSERT INTO) экспортируются вместе."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โครงสร้าง (CREATE TABLE IF NOT EXISTS) และข้อมูล (INSERT INTO) จะถูกส่งออกพร้อมกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şema (CREATE TABLE IF NOT EXISTS) ve veri (INSERT INTO) birlikte dışa aktarılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lược đồ (CREATE TABLE IF NOT EXISTS) và dữ liệu (INSERT INTO) được xuất cùng nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
