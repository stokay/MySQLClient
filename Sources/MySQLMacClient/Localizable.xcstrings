            "value": "Serwer proxy odrzucił połączenie z %@: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O proxy recusou a conexão com %@: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокси-сервер отклонил соединение с %@: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร็อกซีปฏิเสธการเชื่อมต่อไปยัง %@: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy, %@ adresine bağlantıyı reddetti: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy đã từ chối kết nối tới %@: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理服务器拒绝了到 %@ 的连接：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理伺服器拒絕了到 %@ 的連線：%@"
          }
        }
      }
    },
    "The proxy's answer is too long.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ الوكيل طويل جدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort des Proxys ist zu lang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta del proxy es demasiado larga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse du proxy est trop longue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉक्सी का जवाब बहुत लंबा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Respons proxy terlalu panjang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta del proxy è troppo lunga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシの応答が長すぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프록시의 응답이 너무 깁니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedź serwera proxy jest za długa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta do proxy é longa demais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ прокси-сервера слишком длинный."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตอบกลับของพร็อกซียาวเกินไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy'nin yanıtı çok uzun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phản hồi của proxy quá dài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理服务器的响应过长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理伺服器的回應過長。"
          }
        }
      }
    },
    "The server didn't complete the login within %lld seconds. The connection may have been closed before the server answered.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُكمل الخادم تسجيل الدخول خلال %lld ثانية. ربما أُغلق الاتصال قبل أن يردّ الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Anmeldung nicht innerhalb von %lld Sekunden abgeschlossen. Möglicherweise wurde die Verbindung geschlossen, bevor der Server geantwortet hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no completó el inicio de sesión en %lld segundos. Es posible que la conexión se haya cerrado antes de que el servidor respondiera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'a pas terminé l'authentification dans un délai de %lld secondes. La connexion a peut-être été fermée avant que le serveur ne réponde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने %lld सेकंड के भीतर लॉगिन पूरा नहीं किया। हो सकता है कि सर्वर के जवाब देने से पहले ही कनेक्शन बंद हो गया हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server tidak menyelesaikan login dalam %lld detik. Koneksi mungkin sudah ditutup sebelum server merespons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non ha completato l'accesso entro %lld secondi. La connessione potrebbe essere stata chiusa prima che il server rispondesse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが %lld 秒以内にログインを完了しませんでした。サーバーが応答する前に接続が閉じられた可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 %lld초 이내에 로그인을 완료하지 않았습니다. 서버가 응답하기 전에 연결이 닫혔을 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie dokończył logowania w ciągu %lld sekund. Połączenie mogło zostać zamknięte, zanim serwer odpowiedział."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não concluiu o login em %lld segundos. A conexão pode ter sido encerrada antes de o servidor responder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не завершил вход в течение %lld секунд. Возможно, соединение было закрыто до того, как сервер ответил."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าสู่ระบบกับเซิร์ฟเวอร์ไม่เสร็จสิ้นภายใน %lld วินาที การเชื่อมต่ออาจถูกปิดไปก่อนที่เซิร์ฟเวอร์จะตอบกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu oturum açmayı %lld saniye içinde tamamlamadı. Bağlantı, sunucu yanıt vermeden önce kapatılmış olabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ không hoàn tất đăng nhập trong vòng %lld giây. Kết nối có thể đã bị đóng trước khi máy chủ phản hồi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器未在 %lld 秒内完成登录。连接可能在服务器响应之前就已关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器未在 %lld 秒內完成登入。連線可能在伺服器回應之前就已關閉。"
          }
        }
      }
    },
    "The server doesn't offer an encrypted (TLS) connection, so the connection was closed. Turn encryption off for this connection, or enable TLS on the server.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوفّر الخادم اتصالًا مشفّرًا (TLS)، لذا أُغلق الاتصال. أوقف التشفير لهذا الاتصال، أو فعّل TLS على الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server bietet keine verschlüsselte (TLS-)Verbindung an, daher wurde die Verbindung geschlossen. Schalten Sie die Verschlüsselung für diese Verbindung aus oder aktivieren Sie TLS auf dem Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no ofrece una conexión cifrada (TLS), así que se cerró la conexión. Desactiva el cifrado para esta conexión o habilita TLS en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne propose pas de connexion chiffrée (TLS), la connexion a donc été fermée. Désactivez le chiffrement pour cette connexion ou activez TLS sur le serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर एन्क्रिप्टेड (TLS) कनेक्शन नहीं देता, इसलिए कनेक्शन बंद कर दिया गया। इस कनेक्शन के लिए एन्क्रिप्शन बंद करें, या सर्वर पर TLS चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server tidak menyediakan koneksi terenkripsi (TLS), jadi koneksi ditutup. Matikan enkripsi untuk koneksi ini, atau aktifkan TLS di server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non offre una connessione cifrata (TLS), quindi la connessione è stata chiusa. Disattiva la crittografia per questa connessione oppure abilita TLS sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが暗号化（TLS）接続に対応していないため、接続を閉じました。この接続の暗号化をオフにするか、サーバーで TLS を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 암호화(TLS) 연결을 제공하지 않아 연결을 닫았습니다. 이 연결의 암호화를 끄거나 서버에서 TLS를 활성화하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie oferuje szyfrowanego połączenia (TLS), więc połączenie zostało zamknięte. Wyłącz szyfrowanie dla tego połączenia albo włącz TLS na serwerze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não oferece conexão criptografada (TLS), então a conexão foi encerrada. Desative a criptografia para esta conexão ou habilite TLS no servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не поддерживает зашифрованное (TLS) соединение, поэтому соединение закрыто. Отключите шифрование для этого подключения или включите TLS на сервере."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ไม่รองรับการเชื่อมต่อแบบเข้ารหัส (TLS) จึงปิดการเชื่อมต่อแล้ว ให้ปิดการเข้ารหัสสำหรับการเชื่อมต่อนี้ หรือเปิด TLS บนเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu şifreli (TLS) bağlantı sunmuyor, bu yüzden bağlantı kapatıldı. Bu bağlantı için şifrelemeyi kapatın ya da sunucuda TLS'i etkinleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ không hỗ trợ kết nối mã hóa (TLS), nên kết nối đã bị đóng. Hãy tắt mã hóa cho kết nối này, hoặc bật TLS trên máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器不提供加密（TLS）连接，因此已关闭连接。请为此连接关闭加密，或在服务器上启用 TLS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器不提供加密（TLS）連線，因此已關閉連線。請為此連線關閉加密，或在伺服器上啟用 TLS。"
          }
        }
      }
    },
    "The view definition (CREATE OR REPLACE VIEW) is exported — a view has no rows of its own, so no data is written separately.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تصدير تعريف العرض (CREATE OR REPLACE VIEW) — لا يحتوي العرض على صفوف خاصة به، لذا لا تُكتب أي بيانات بشكل منفصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ansichtsdefinition (CREATE OR REPLACE VIEW) wird exportiert — eine Ansicht hat keine eigenen Zeilen, daher werden keine Daten separat geschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se exporta la definición de la vista (CREATE OR REPLACE VIEW) — una vista no tiene filas propias, por lo que no se escriben datos por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La définition de la vue (CREATE OR REPLACE VIEW) est exportée — une vue n'a pas de lignes propres, aucune donnée n'est donc écrite séparément."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यू परिभाषा (CREATE OR REPLACE VIEW) निर्यात की जाती है — व्यू की अपनी कोई पंक्तियाँ नहीं होतीं, इसलिए अलग से कोई डेटा नहीं लिखा जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Definisi view (CREATE OR REPLACE VIEW) diekspor — view tidak memiliki baris sendiri, sehingga tidak ada data yang ditulis terpisah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene esportata la definizione della vista (CREATE OR REPLACE VIEW) — una vista non ha righe proprie, quindi nessun dato viene scritto separatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューの定義 (CREATE OR REPLACE VIEW) がエクスポートされます — ビューは独自の行を持たないため、データが別途書き込まれることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뷰 정의(CREATE OR REPLACE VIEW)가 내보내집니다 — 뷰는 자체 행이 없으므로 데이터가 별도로 기록되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportowana jest definicja widoku (CREATE OR REPLACE VIEW) — widok nie ma własnych wierszy, więc żadne dane nie są zapisywane osobno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A definição da view (CREATE OR REPLACE VIEW) é exportada — uma view não possui linhas próprias, portanto nenhum dado é gravado separadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируется определение представления (CREATE OR REPLACE VIEW) — у представления нет собственных строк, поэтому данные отдельно не записываются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำนิยามของมุมมอง (CREATE OR REPLACE VIEW) จะถูกส่งออก — มุมมองไม่มีแถวข้อมูลของตัวเอง จึงไม่มีการเขียนข้อมูลแยกต่างหาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "View tanımı (CREATE OR REPLACE VIEW) dışa aktarılır — bir view'ın kendine ait satırları olmadığından veri ayrıca yazılmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định nghĩa khung nhìn (CREATE OR REPLACE VIEW) được xuất — khung nhìn không có hàng dữ liệu riêng, nên không có dữ liệu nào được ghi thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会导出视图定义 (CREATE OR REPLACE VIEW) — 视图本身没有行，因此不会单独写入数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會匯出檢視表定義 (CREATE OR REPLACE VIEW) — 檢視表本身沒有資料列，因此不會另外寫入任何資料。"
          }
        }
      }
    },
