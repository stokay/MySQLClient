    "-- SQL will appear here once you enter a table name and at least one column name --": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "-- سيظهر SQL هنا بمجرد إدخال اسم الجدول واسم عمود واحد على الأقل --"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "-- SQL erscheint hier, sobald ein Tabellenname und mindestens ein Spaltenname eingegeben wurden --"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "-- El SQL aparecerá aquí en cuanto introduzcas un nombre de tabla y al menos un nombre de columna --"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "-- Le SQL apparaîtra ici une fois que vous aurez saisi un nom de table et au moins un nom de colonne --"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "-- टेबल नाम और कम से कम एक कॉलम नाम दर्ज करने पर SQL यहाँ दिखाई देगा --"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "-- SQL akan muncul di sini setelah Anda memasukkan nama tabel dan setidaknya satu nama kolom --"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "-- L'SQL apparirà qui dopo aver inserito un nome tabella e almeno un nome colonna --"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "-- テーブル名と少なくとも1つの列名を入力すると、ここに SQL が表示されます --"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "-- 테이블 이름과 하나 이상의 열 이름을 입력하면 여기에 SQL이 표시됩니다 --"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "-- SQL pojawi się tutaj po wpisaniu nazwy tabeli i przynajmniej jednej nazwy kolumny --"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "-- O SQL aparecerá aqui assim que você inserir um nome de tabela e pelo menos um nome de coluna --"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "-- SQL появится здесь, как только вы укажете имя таблицы и хотя бы одно имя столбца --"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "-- SQL จะปรากฏที่นี่เมื่อคุณป้อนชื่อตารางและชื่อคอลัมน์อย่างน้อยหนึ่งคอลัมน์ --"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "-- Tablo adı ve en az bir kolon adı girildiğinde SQL burada görünecek --"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "-- SQL sẽ xuất hiện ở đây khi bạn nhập tên bảng và ít nhất một tên cột --"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "-- 输入表名和至少一个列名后，SQL 将显示在此处 --"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "-- 輸入表格名稱與至少一個欄位名稱後，SQL 將顯示於此 --"
          }
        }
      }
    },
