    "Ideas, suggestions, problems, bugs — your message goes straight to the developer.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفكار، اقتراحات، مشكلات، أخطاء — تصل رسالتك مباشرةً إلى المطوّر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideen, Vorschläge, Probleme, Fehler — Ihre Nachricht geht direkt an den Entwickler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideas, sugerencias, problemas, errores: tu mensaje llega directamente al desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idées, suggestions, problèmes, bugs — votre message parvient directement au développeur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विचार, सुझाव, समस्याएँ, बग — आपका संदेश सीधे डेवलपर तक पहुँचता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ide, saran, masalah, bug — pesan Anda langsung sampai ke pengembang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Idee, suggerimenti, problemi, bug — il tuo messaggio arriva direttamente allo sviluppatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイデア、提案、問題、バグ — メッセージは開発者に直接届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이디어, 제안, 문제, 버그 — 메시지는 개발자에게 직접 전달됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomysły, sugestie, problemy, błędy — Twoja wiadomość trafia bezpośrednio do twórcy aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideias, sugestões, problemas, bugs — sua mensagem vai direto para o desenvolvedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идеи, предложения, проблемы, ошибки — ваше сообщение попадёт напрямую к разработчику."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอเดีย ข้อเสนอแนะ ปัญหา บั๊ก — ข้อความของคุณจะถูกส่งตรงถึงนักพัฒนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fikirler, öneriler, sorunlar, hatalar — mesajınız doğrudan geliştiriciye ulaşır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ý tưởng, đề xuất, sự cố, lỗi — tin nhắn của bạn được gửi thẳng đến nhà phát triển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想法、建议、问题、错误 — 你的消息将直接发送给开发者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想法、建議、問題、錯誤 — 你的訊息會直接傳送給開發者。"
          }
        }
      }
    },
