    "History is kept only on this Mac, up to %lld queries per connection.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf wird nur auf diesem Mac gespeichert, bis zu %lld Abfragen pro Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial se guarda solo en este Mac, hasta %lld consultas por conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique n'est conservé que sur ce Mac, jusqu'à %lld requêtes par connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास केवल इस Mac पर रखा जाता है, प्रति कनेक्शन अधिकतम %lld क्वेरी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴はこの Mac にのみ保存され、接続ごとに最大 %lld 件です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia jest przechowywana tylko na tym Macu, maksymalnie %lld zapytań na połączenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico é mantido apenas neste Mac, com até %lld consultas por conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История хранится только на этом Mac, до %lld запросов на подключение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş yalnızca bu Mac'te, bağlantı başına en fazla %lld sorgu olarak saklanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录仅保存在此 Mac 上，每个连接最多 %lld 条查询。"
          }
        }
      }
    },
    "History: recent queries run on this connection — the selected query is appended to the editor": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf: zuletzt auf dieser Verbindung ausgeführte Abfragen — die ausgewählte Abfrage wird an den Editor angehängt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial: consultas recientes ejecutadas en esta conexión — la consulta seleccionada se añade al editor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique : requêtes récentes exécutées sur cette connexion — la requête sélectionnée est ajoutée à l'éditeur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास: इस कनेक्शन पर हाल ही में चलाई गई क्वेरी — चयनित क्वेरी संपादक में जोड़ दी जाती है"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴: この接続で実行された最近のクエリ — 選択したクエリはエディタに追加されます"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia: ostatnie zapytania wykonane w tym połączeniu — wybrane zapytanie zostaje dodane do edytora"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Histórico: consultas recentes executadas nesta conexão — a consulta selecionada é adicionada ao editor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История: последние запросы, выполненные в этом подключении — выбранный запрос добавляется в редактор"
