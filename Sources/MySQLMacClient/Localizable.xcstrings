    "Collation": {
      "extractionState": "manual"
    },
    "Collation '%@' does not exist on %@. Replace it with one this server supports.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kollation „%1$@“ gibt es auf %2$@ nicht. Ersetzen Sie sie durch eine, die dieser Server unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La intercalación '%1$@' no existe en %2$@. Sustitúyala por una que este servidor admita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement « %1$@ » n'existe pas sur %2$@. Remplacez-le par un classement pris en charge par ce serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Collation '%1$@' %2$@ पर मौजूद नहीं है। इसे इस सर्वर द्वारा समर्थित किसी collation से बदलें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "照合順序 '%1$@' は %2$@ に存在しません。このサーバーがサポートするものに置き換えてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porządek sortowania „%1$@” nie istnieje na %2$@. Zastąp go takim, który obsługuje ten serwer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O collation '%1$@' não existe em %2$@. Substitua-o por um suportado por este servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр сортировки «%1$@» отсутствует на %2$@. Замените его на поддерживаемый этим сервером."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@' collation'ı %2$@ sunucusunda yok. Bu sunucunun desteklediği bir collation ile değiştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排序规则 “%1$@” 在 %2$@ 上不存在。请将其替换为此服务器支持的排序规则。"
          }
        }
      }
    },
    "Collation '%@' does not exist on the server you are connected to. Replace it with one this server supports.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kollation „%@“ gibt es auf dem verbundenen Server nicht. Ersetzen Sie sie durch eine, die dieser Server unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La intercalación '%@' no existe en el servidor al que está conectado. Sustitúyala por una que este servidor admita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement « %@ » n'existe pas sur le serveur auquel vous êtes connecté. Remplacez-le par un classement pris en charge par ce serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Collation '%@' उस सर्वर पर मौजूद नहीं है जिससे आप जुड़े हैं। इसे इस सर्वर द्वारा समर्थित किसी collation से बदलें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "照合順序 '%@' は接続先のサーバーに存在しません。このサーバーがサポートするものに置き換えてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porządek sortowania „%@” nie istnieje na serwerze, z którym jesteś połączony. Zastąp go takim, który obsługuje ten serwer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O collation '%@' não existe no servidor ao qual você está conectado. Substitua-o por um suportado por este servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр сортировки «%@» отсутствует на сервере, к которому вы подключены. Замените его на поддерживаемый этим сервером."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' collation'ı bağlı olduğunuz sunucuda yok. Bu sunucunun desteklediği bir collation ile değiştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排序规则 “%@” 在你连接的服务器上不存在。请将其替换为此服务器支持的排序规则。"
          }
        }
      }
    },
