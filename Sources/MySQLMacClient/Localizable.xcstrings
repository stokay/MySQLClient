    "The view definition (CREATE OR REPLACE VIEW) is exported — a view has no rows of its own, so no data is written separately.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تصدير تعريف العرض (CREATE OR REPLACE VIEW) — لا يحتوي العرض على صفوف خاصة به، لذا لا تُكتب أي بيانات بشكل منفصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ansichtsdefinition (CREATE OR REPLACE VIEW) wird exportiert — eine Ansicht hat keine eigenen Zeilen, daher werden keine Daten separat geschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se exporta la definición de la vista (CREATE OR REPLACE VIEW) — una vista no tiene filas propias, por lo que no se escriben datos por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La définition de la vue (CREATE OR REPLACE VIEW) est exportée — une vue n'a pas de lignes propres, aucune donnée n'est donc écrite séparément."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यू परिभाषा (CREATE OR REPLACE VIEW) निर्यात की जाती है — व्यू की अपनी कोई पंक्तियाँ नहीं होतीं, इसलिए अलग से कोई डेटा नहीं लिखा जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Definisi view (CREATE OR REPLACE VIEW) diekspor — view tidak memiliki baris sendiri, sehingga tidak ada data yang ditulis terpisah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene esportata la definizione della vista (CREATE OR REPLACE VIEW) — una vista non ha righe proprie, quindi nessun dato viene scritto separatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューの定義 (CREATE OR REPLACE VIEW) がエクスポートされます — ビューは独自の行を持たないため、データが別途書き込まれることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뷰 정의(CREATE OR REPLACE VIEW)가 내보내집니다 — 뷰는 자체 행이 없으므로 데이터가 별도로 기록되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportowana jest definicja widoku (CREATE OR REPLACE VIEW) — widok nie ma własnych wierszy, więc żadne dane nie są zapisywane osobno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A definição da view (CREATE OR REPLACE VIEW) é exportada — uma view não possui linhas próprias, portanto nenhum dado é gravado separadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируется определение представления (CREATE OR REPLACE VIEW) — у представления нет собственных строк, поэтому данные отдельно не записываются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำนิยามของมุมมอง (CREATE OR REPLACE VIEW) จะถูกส่งออก — มุมมองไม่มีแถวข้อมูลของตัวเอง จึงไม่มีการเขียนข้อมูลแยกต่างหาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "View tanımı (CREATE OR REPLACE VIEW) dışa aktarılır — bir view'ın kendine ait satırları olmadığından veri ayrıca yazılmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định nghĩa khung nhìn (CREATE OR REPLACE VIEW) được xuất — khung nhìn không có hàng dữ liệu riêng, nên không có dữ liệu nào được ghi thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会导出视图定义 (CREATE OR REPLACE VIEW) — 视图本身没有行，因此不会单独写入数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會匯出檢視表定義 (CREATE OR REPLACE VIEW) — 檢視表本身沒有資料列，因此不會另外寫入任何資料。"
          }
        }
      }
    },
