    "When off, the page size is ignored and the whole table is loaded.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف، يتم تجاهل حجم الصفحة ويتم تحميل الجدول بالكامل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deaktiviert, wird die Seitengröße ignoriert und die gesamte Tabelle geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, se ignora el tamaño de página y se carga la tabla completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque désactivé, la taille de page est ignorée et la table entière est chargée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद होने पर, पेज आकार अनदेखा किया जाता है और पूरी टेबल लोड होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika nonaktif, ukuran halaman diabaikan dan seluruh tabel dimuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, la dimensione della pagina viene ignorata e l'intera tabella viene caricata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、ページサイズは無視され、テーブル全体が読み込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 페이지 크기가 무시되고 전체 테이블이 로드됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wyłączone, rozmiar strony jest ignorowany i wczytywana jest cała tabela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, o tamanho da página é ignorado e a tabela inteira é carregada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, размер страницы игнорируется и загружается вся таблица."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิดใช้งาน จะไม่สนใจขนาดหน้าและโหลดทั้งตาราง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatılırsa sayfa boyutu yok sayılır ve tablonun tamamı yüklenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, kích thước trang sẽ bị bỏ qua và toàn bộ bảng được tải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时将忽略分页大小，加载整张表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時將忽略分頁大小，並載入整個表格。"
          }
        }
      }
    },
    "You must add at least one column.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب إضافة عمود واحد على الأقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie müssen mindestens eine Spalte hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes añadir al menos una columna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez ajouter au moins une colonne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको कम से कम एक कॉलम जोड़ना होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda harus menambahkan setidaknya satu kolom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi aggiungere almeno una colonna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも1つの列を追加する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열을 하나 이상 추가해야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Musisz dodać przynajmniej jedną kolumnę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você deve adicionar pelo menos uma coluna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необходимо добавить хотя бы один столбец."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณต้องเพิ่มคอลัมน์อย่างน้อยหนึ่งคอลัมน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az bir kolon eklemelisiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn phải thêm ít nhất một cột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须至少添加一列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須至少新增一個欄位。"
          }
        }
      }
    },
    "You must map at least one column to import.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تخطيط عمود واحد على الأقل للاستيراد."
          }
        },
