            "state": "translated",
            "value": "'%@' bir MySQL 8.0 collation'ı. Değiştirin (genelde utf8mb4_unicode_ci kullanılır) ya da MySQL 8.0+ sunucuya yükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' là collation của MySQL 8.0. Hãy thay thế nó (utf8mb4_unicode_ci thường được dùng thay thế) hoặc khôi phục vào MySQL 8.0 trở lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 是 MySQL 8.0 的排序规则。请替换它（通常用 utf8mb4_unicode_ci 代替）或还原到 MySQL 8.0 或更高版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」是 MySQL 8.0 的定序。請替換它（通常以 utf8mb4_unicode_ci 代替）或還原到 MySQL 8.0 或更新版本。"
          }
        }
      }
    },
