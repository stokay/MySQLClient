    "Permanently delete the %@ '%@'?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ „%@“ dauerhaft löschen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@ \"%@\" permanentemente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer définitivement %1$@ « %2$@ » ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ '%2$@' को स्थायी रूप से हटाएँ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ '%2$@' を完全に削除しますか？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usunąć %1$@ „%2$@”?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir permanentemente %1$@ '%2$@'?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %1$@ «%2$@» безвозвратно?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' '%@' tamamen silinsin mi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除 %1$@ “%2$@”？"
          }
        }
      }
    },
