    "When off, the page size is ignored and the whole table is loaded.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deaktiviert, wird die Seitengröße ignoriert und die gesamte Tabelle geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, se ignora el tamaño de página y se carga la tabla completa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद होने पर, पेज आकार अनदेखा किया जाता है और पूरी टेबल लोड होती है।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wyłączone, rozmiar strony jest ignorowany i wczytywana jest cała tabela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, размер страницы игнорируется и загружается вся таблица."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatılırsa sayfa boyutu yok sayılır ve tablonun tamamı yüklenir."
          }
        }
      }
    },
    "You must add at least one column.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie müssen mindestens eine Spalte hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes añadir al menos una columna."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको कम से कम एक कॉलम जोड़ना होगा।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Musisz dodać przynajmniej jedną kolumnę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необходимо добавить хотя бы один столбец."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az bir kolon eklemelisiniz."
          }
        }
      }
    },
    "You must map at least one column to import.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie müssen mindestens eine Spalte zum Importieren zuordnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes asignar al menos una columna para importar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयात करने के लिए आपको कम से कम एक कॉलम मैप करना होगा।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zaimportować, musisz zmapować przynajmniej jedną kolumnę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для импорта необходимо сопоставить хотя бы один столбец."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarmak için en az bir kolonu eşlemelisiniz."
          }
        }
      }
    },
