    "The App Sandbox keeps this build from running command-line tools installed outside the app.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمنع بيئة App Sandbox هذا الإصدار من تشغيل أدوات سطر الأوامر المثبّتة خارج التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Sandbox verhindert, dass diese Version Befehlszeilenwerkzeuge ausführt, die außerhalb der App installiert sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Sandbox impide que esta versión ejecute herramientas de línea de comandos instaladas fuera de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Sandbox empêche cette version d'exécuter des outils en ligne de commande installés en dehors de l'application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox इस बिल्ड को ऐप के बाहर इंस्टॉल किए गए कमांड-लाइन टूल चलाने से रोकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox mencegah versi ini menjalankan alat baris perintah yang terpasang di luar aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Sandbox impedisce a questa versione di eseguire strumenti da riga di comando installati al di fuori dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox により、このビルドではアプリの外にインストールされたコマンドラインツールを実行できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox 때문에 이 빌드에서는 앱 외부에 설치된 명령줄 도구를 실행할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox nie pozwala tej wersji uruchamiać narzędzi wiersza poleceń zainstalowanych poza aplikacją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O App Sandbox impede que esta versão execute ferramentas de linha de comando instaladas fora do aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox не позволяет этой сборке запускать инструменты командной строки, установленные вне приложения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox ทำให้บิลด์นี้เรียกใช้เครื่องมือบรรทัดคำสั่งที่ติดตั้งไว้นอกแอปไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox, bu sürümün uygulamanın dışında kurulu komut satırı araçlarını çalıştırmasını engelliyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox ngăn bản dựng này chạy các công cụ dòng lệnh được cài đặt bên ngoài ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox 不允许此版本运行安装在应用之外的命令行工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Sandbox 不允許此版本執行安裝在應用程式之外的命令列工具。"
          }
        }
      }
    },
    "The SSH connection didn't open within 45 seconds.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُفتح اتصال SSH خلال 45 ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SSH-Verbindung wurde nicht innerhalb von 45 Sekunden hergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión SSH no se abrió en 45 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion SSH ne s'est pas ouverte dans un délai de 45 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH कनेक्शन 45 सेकंड के भीतर नहीं खुला।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi SSH tidak terbuka dalam 45 detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione SSH non si è aperta entro 45 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 接続が 45 秒以内に確立されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 연결이 45초 이내에 열리지 않았습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie SSH nie zostało nawiązane w ciągu 45 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão SSH não foi aberta em 45 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH-соединение не было установлено в течение 45 секунд."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปิดการเชื่อมต่อ SSH ได้ภายใน 45 วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH bağlantısı 45 saniye içinde açılmadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở kết nối SSH trong vòng 45 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 连接未在 45 秒内建立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 連線未在 45 秒內建立。"
          }
        }
      }
    },
