    "Use the database named in the file (its USE and CREATE DATABASE statements)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام قاعدة البيانات المذكورة في الملف (عبارات USE وCREATE DATABASE فيه)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die in der Datei genannte Datenbank verwenden (ihre USE- und CREATE-DATABASE-Anweisungen)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar la base de datos indicada en el archivo (sus sentencias USE y CREATE DATABASE)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser la base de données nommée dans le fichier (ses instructions USE et CREATE DATABASE)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल में बताए गए डेटाबेस का उपयोग करें (उसके USE और CREATE DATABASE स्टेटमेंट)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan database yang disebut dalam file (pernyataan USE dan CREATE DATABASE-nya)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il database indicato nel file (le sue istruzioni USE e CREATE DATABASE)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルに書かれたデータベースを使う（その USE と CREATE DATABASE 文）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 지정된 데이터베이스 사용 (파일의 USE 및 CREATE DATABASE 문)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj bazy danych wskazanej w pliku (jego instrukcji USE i CREATE DATABASE)"
          }
        },
        "pt-BR": {
