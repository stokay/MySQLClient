    "Only the table structure is created — no records are imported. Review the suggested types below before creating.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nur die Tabellenstruktur erstellt — es werden keine Datensätze importiert. Überprüfen Sie die vorgeschlagenen Typen unten, bevor Sie erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se crea la estructura de la tabla — no se importan registros. Revisa los tipos sugeridos a continuación antes de crear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la structure de la table est créée — aucun enregistrement n'est importé. Vérifiez les types suggérés ci-dessous avant de créer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल टेबल संरचना बनाई जाती है — कोई रिकॉर्ड आयात नहीं किया जाता। बनाने से पहले नीचे सुझाए गए प्रकार देख लें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーブル構造のみが作成され、レコードはインポートされません。作成前に、以下の推奨される型を確認してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzona jest tylko struktura tabeli — żadne rekordy nie są importowane. Przed utworzeniem sprawdź proponowane poniżej typy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente a estrutura da tabela é criada — nenhum registro é importado. Revise os tipos sugeridos abaixo antes de criar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаётся только структура таблицы — записи не импортируются. Перед созданием проверьте предложенные ниже типы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca tablo yapısı oluşturulur — kayıtlar içe aktarılmaz. Oluşturmadan önce aşağıdaki önerilen tipleri gözden geçirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅创建表结构 — 不导入任何记录。创建前请检查下方建议的类型。"
          }
        }
      }
    },
