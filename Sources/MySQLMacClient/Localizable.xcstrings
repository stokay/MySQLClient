          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial: consultas recientes ejecutadas en esta conexión — la consulta seleccionada se añade al editor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique : requêtes récentes exécutées sur cette connexion — la requête sélectionnée est ajoutée à l'éditeur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास: इस कनेक्शन पर हाल ही में चलाई गई क्वेरी — चयनित क्वेरी संपादक में जोड़ दी जाती है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat: query terbaru yang dijalankan pada koneksi ini — query yang dipilih akan ditambahkan ke editor"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronologia: query recenti eseguite su questa connessione — la query selezionata viene aggiunta all'editor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴: この接続で実行された最近のクエリ — 選択したクエリはエディタに追加されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록: 이 연결에서 최근 실행한 쿼리 — 선택한 쿼리가 편집기에 추가됩니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia: ostatnie zapytania wykonane w tym połączeniu — wybrane zapytanie zostaje dodane do edytora"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Histórico: consultas recentes executadas nesta conexão — a consulta selecionada é adicionada ao editor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История: последние запросы, выполненные в этом подключении — выбранный запрос добавляется в редактор"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติ: คำสั่ง SQL ล่าสุดที่รันบนการเชื่อมต่อนี้ — คำสั่งที่เลือกจะถูกเพิ่มลงในตัวแก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş: bu bağlantıda çalıştırılan son sorgular — seçilen sorgu editörün sonuna eklenir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử: các câu lệnh gần đây đã chạy trên kết nối này — câu lệnh được chọn sẽ được thêm vào trình soạn thảo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
