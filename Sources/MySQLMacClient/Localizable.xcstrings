    "Optional — only if you'd like a reply": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري — فقط إذا كنت ترغب في تلقي رد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional — nur, wenn Sie eine Antwort wünschen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional — solo si quieres una respuesta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif — uniquement si vous souhaitez une réponse"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक — केवल तब, जब आप उत्तर चाहते हों"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional — hanya jika Anda ingin dibalas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo — solo se desideri una risposta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意 — 返信をご希望の場合のみ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항 — 답장을 원하는 경우에만"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne — tylko jeśli chcesz otrzymać odpowiedź"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional — somente se você quiser uma resposta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно — только если вам нужен ответ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับ — เฉพาะเมื่อคุณต้องการให้ตอบกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsiyonel — yalnızca yanıt isterseniz"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn — chỉ khi bạn muốn nhận phản hồi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选 — 仅在你希望收到回复时填写"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選 — 僅在你希望收到回覆時填寫"
          }
        }
      }
    },
