    "'%@' is a MySQL 8.0 collation, but this connection is to %@. Replace it (utf8mb4_unicode_ci is the usual substitute) or restore into MySQL 8.0 or newer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist eine MySQL-8.0-Kollation, diese Verbindung geht aber zu %2$@. Ersetzen Sie sie (üblich ist utf8mb4_unicode_ci) oder spielen Sie in MySQL 8.0 oder neuer ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@' es una intercalación de MySQL 8.0, pero esta conexión es a %2$@. Sustitúyala (utf8mb4_unicode_ci es lo habitual) o restaure en MySQL 8.0 o posterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est un classement MySQL 8.0, mais cette connexion est établie avec %2$@. Remplacez-le (utf8mb4_unicode_ci est le substitut habituel) ou restaurez vers MySQL 8.0 ou plus récent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@' एक MySQL 8.0 collation है, लेकिन यह कनेक्शन %2$@ से है। इसे बदलें (आमतौर पर utf8mb4_unicode_ci उपयुक्त है) या MySQL 8.0 या नए संस्करण में पुनर्स्थापित करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@' は MySQL 8.0 の照合順序ですが、この接続先は %2$@ です。置き換えるか（通常は utf8mb4_unicode_ci で代替）、MySQL 8.0 以降に復元してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” to porządek sortowania z MySQL 8.0, ale to połączenie dotyczy %2$@. Zastąp go (zwykle odpowiedni jest utf8mb4_unicode_ci) albo przywróć w MySQL 8.0 lub nowszym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@' é um collation do MySQL 8.0, mas esta conexão é com %2$@. Substitua-o (utf8mb4_unicode_ci é o substituto habitual) ou restaure em um MySQL 8.0 ou mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» — параметр сортировки MySQL 8.0, но это соединение выполнено с %2$@. Замените его (обычно подходит utf8mb4_unicode_ci) или восстановите в MySQL 8.0 или новее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@' bir MySQL 8.0 collation'ı, bu bağlantı ise %2$@ sunucusuna. Değiştirin (genelde utf8mb4_unicode_ci kullanılır) ya da MySQL 8.0+ sunucuya yükleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” 是 MySQL 8.0 的排序规则，但此连接的对象是 %2$@。请替换它（通常用 utf8mb4_unicode_ci 代替）或还原到 MySQL 8.0 或更高版本。"
          }
        }
      }
    },
