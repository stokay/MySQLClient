          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프록시가 %@에 대한 연결을 거부했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer proxy odrzucił połączenie z %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O proxy recusou a conexão com %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокси-сервер отклонил соединение с %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร็อกซีปฏิเสธการเชื่อมต่อไปยัง %@"
          }
        },
        "tr": {
          "stringUnit": {
