          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DROP EVENT kalıcı olarak siler, geri alınamaz."
          }
        }
      }
    },
    "This script holds several statements. \"Run\" sends them as one packet; use \"Run All\" to send them one at a time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Skript enthält mehrere Anweisungen. „Ausführen“ sendet sie als ein Paket; verwenden Sie „Alles Ausführen“, um sie einzeln zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este script contiene varias sentencias. «Ejecutar» las envía en un solo paquete; use «Ejecutar Todo» para enviarlas una por una."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu script birden fazla ifade içeriyor. “Çalıştır” hepsini tek pakette gönderir; teker teker göndermek için “Tümünü Çalıştır” kullanın."
          }
        }
      }
    },
    "'%@' is a MySQL 8.0 collation, but this connection is to %@. Replace it (utf8mb4_unicode_ci is the usual substitute) or restore into MySQL 8.0 or newer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist eine MySQL-8.0-Kollation, diese Verbindung geht aber zu %2$@. Ersetzen Sie sie (üblich ist utf8mb4_unicode_ci) oder spielen Sie in MySQL 8.0 oder neuer ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@' es una intercalación de MySQL 8.0, pero esta conexión es a %2$@. Sustitúyala (utf8mb4_unicode_ci es lo habitual) o restaure en MySQL 8.0 o posterior."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@' bir MySQL 8.0 collation'ı, bu bağlantı ise %2$@ sunucusuna. Değiştirin (genelde utf8mb4_unicode_ci kullanılır) ya da MySQL 8.0+ sunucuya yükleyin."
          }
        }
      }
    },
    "'%@' is a MySQL 8.0 collation. Replace it (utf8mb4_unicode_ci is the usual substitute) or restore into MySQL 8.0 or newer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
