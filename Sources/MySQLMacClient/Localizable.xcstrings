          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' é um collation do MySQL 8.0. Substitua-o (utf8mb4_unicode_ci é o substituto habitual) ou restaure em um MySQL 8.0 ou mais recente."
          }
