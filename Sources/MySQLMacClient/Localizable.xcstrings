    "Connection details, queries and your data are never included. Please don't put passwords in your message.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُضمَّن أبدًا تفاصيل الاتصال أو الاستعلامات أو بياناتك. يُرجى عدم كتابة كلمات المرور في رسالتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungsdaten, Abfragen und Ihre Daten werden nie mitgesendet. Bitte schreiben Sie keine Passwörter in Ihre Nachricht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se incluyen los datos de conexión, las consultas ni tus datos. No escribas contraseñas en el mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations de connexion, les requêtes et vos données ne sont jamais incluses. N'indiquez pas de mot de passe dans votre message."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन विवरण, क्वेरी और आपका डेटा कभी शामिल नहीं किया जाता। कृपया अपने संदेश में पासवर्ड न लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detail koneksi, query, dan data Anda tidak pernah disertakan. Jangan menuliskan kata sandi dalam pesan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di connessione, le query e i tuoi dati non vengono mai inclusi. Non inserire password nel messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続情報、クエリ、データが含まれることはありません。メッセージにパスワードを書かないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 정보, 쿼리 및 데이터는 절대 포함되지 않습니다. 메시지에 비밀번호를 적지 마세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane połączenia, zapytania i Twoje dane nigdy nie są dołączane. Nie wpisuj haseł w wiadomości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados de conexão, consultas e seus dados nunca são incluídos. Não coloque senhas na mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные подключения, запросы и ваши данные никогда не включаются. Не указывайте пароли в сообщении."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะไม่มีการแนบรายละเอียดการเชื่อมต่อ query หรือข้อมูลของคุณ โปรดอย่าใส่รหัสผ่านในข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı bilgileri, sorgular ve verileriniz asla eklenmez. Lütfen mesajınıza şifre yazmayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin kết nối, truy vấn và dữ liệu của bạn không bao giờ được gửi kèm. Vui lòng không ghi mật khẩu trong tin nhắn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不会包含连接信息、查询内容和你的数据。请不要在消息中填写密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不會包含連線資訊、查詢內容和你的資料。請勿在訊息中填寫密碼。"
          }
        }
      }
    },
