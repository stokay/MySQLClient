    "The connection to the server dropped at line %lld. The statements before it were restored.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال بالخادم عند السطر %lld. تمت استعادة العبارات التي قبله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zum Server ist bei Zeile %lld abgebrochen. Die Anweisungen davor wurden wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión con el servidor se cortó en la línea %lld. Las sentencias anteriores se restauraron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion au serveur a été interrompue à la ligne %lld. Les instructions précédentes ont été restaurées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंक्ति %lld पर सर्वर से कनेक्शन टूट गया। उससे पहले के स्टेटमेंट रीस्टोर हो गए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi ke server terputus di baris %lld. Pernyataan sebelumnya telah dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione al server si è interrotta alla riga %lld. Le istruzioni precedenti sono state ripristinate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 行目でサーバーとの接続が切れました。それより前の文は復元されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld행에서 서버 연결이 끊어졌습니다. 그 이전의 문은 복원되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie z serwerem zostało przerwane w wierszu %lld. Wcześniejsze instrukcje zostały przywrócone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão com o servidor caiu na linha %lld. As instruções anteriores foram restauradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение с сервером прервалось на строке %lld. Операторы до неё восстановлены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อกับเซิร์ฟเวอร์หลุดที่บรรทัด %lld คำสั่งก่อนหน้านั้นถูกกู้คืนแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bağlantısı %lld. satırda koptu. Ondan önceki ifadeler geri yüklendi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối tới máy chủ bị ngắt ở dòng %lld. Các câu lệnh trước đó đã được khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在第 %lld 行与服务器的连接中断。此前的语句已恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在第 %lld 行與伺服器的連線中斷。之前的陳述式已還原。"
          }
        }
      }
    },
    "The connection to the server dropped during the backup. The rest would have been read outside the backup's snapshot and settings, so nothing was saved. Run the backup again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال بالخادم أثناء النسخ الاحتياطي. كان الباقي سيُقرأ خارج اللقطة والإعدادات الخاصة بالنسخ الاحتياطي، لذلك لم يُحفظ شيء. شغّل النسخ الاحتياطي مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zum Server ist während der Sicherung abgebrochen. Der Rest wäre außerhalb des Snapshots und der Einstellungen der Sicherung gelesen worden, daher wurde nichts gespeichert. Starten Sie die Sicherung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión con el servidor se cortó durante la copia de seguridad. El resto se habría leído fuera de la instantánea y la configuración de la copia, así que no se guardó nada. Vuelve a ejecutar la copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion au serveur a été interrompue pendant la sauvegarde. Le reste aurait été lu hors de l'instantané et des réglages de la sauvegarde, donc rien n'a été enregistré. Relancez la sauvegarde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप के दौरान सर्वर से कनेक्शन टूट गया। बाकी हिस्सा बैकअप के स्नैपशॉट और सेटिंग्स के बाहर पढ़ा जाता, इसलिए कुछ भी सेव नहीं किया गया। बैकअप फिर से चलाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi ke server terputus saat pencadangan. Sisanya akan terbaca di luar snapshot dan pengaturan pencadangan, jadi tidak ada yang disimpan. Jalankan pencadangan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione al server si è interrotta durante il backup. Il resto sarebbe stato letto fuori dallo snapshot e dalle impostazioni del backup, quindi non è stato salvato nulla. Esegui di nuovo il backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ中にサーバーとの接続が切れました。残りはバックアップのスナップショットと設定の外で読み込まれることになるため、何も保存しませんでした。もう一度バックアップを実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 중에 서버 연결이 끊어졌습니다. 나머지는 백업의 스냅샷과 설정 밖에서 읽혔을 것이므로 아무것도 저장하지 않았습니다. 백업을 다시 실행하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie z serwerem zostało przerwane podczas kopii zapasowej. Reszta zostałaby odczytana poza migawką i ustawieniami kopii, więc niczego nie zapisano. Uruchom kopię zapasową ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão com o servidor caiu durante o backup. O restante seria lido fora do snapshot e das configurações do backup, então nada foi salvo. Execute o backup novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение с сервером прервалось во время резервного копирования. Остальное было бы прочитано вне снимка и настроек резервной копии, поэтому ничего не сохранено. Запустите резервное копирование ещё раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อกับเซิร์ฟเวอร์หลุดระหว่างการสำรองข้อมูล ส่วนที่เหลือจะถูกอ่านนอกสแนปช็อตและการตั้งค่าของการสำรองข้อมูล จึงไม่ได้บันทึกอะไรไว้ โปรดสำรองข้อมูลอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleme sırasında sunucu bağlantısı koptu. Geri kalanı yedeklemenin anlık görüntüsü ve ayarları dışında okunacaktı, bu yüzden hiçbir şey kaydedilmedi. Yedeklemeyi yeniden çalıştırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối tới máy chủ bị ngắt trong khi sao lưu. Phần còn lại sẽ được đọc ngoài ảnh chụp và cài đặt của bản sao lưu, nên không có gì được lưu. Hãy chạy lại sao lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份期间与服务器的连接中断。其余部分将在备份的快照和设置之外读取，因此未保存任何内容。请重新运行备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份期間與伺服器的連線中斷。其餘部分將在備份的快照與設定之外讀取，因此未儲存任何內容。請重新執行備份。"
          }
        }
      }
    },
    "The message could not be accepted. Please check it and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر قبول الرسالة. يُرجى التحقق منها والمحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht konnte nicht angenommen werden. Bitte prüfen Sie sie und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo aceptar el mensaje. Revísalo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message n'a pas pu être accepté. Veuillez le vérifier et réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदेश स्वीकार नहीं किया जा सका। कृपया इसे जाँचें और फिर प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan tidak dapat diterima. Periksa kembali dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile accettare il messaggio. Controllalo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを受け付けられませんでした。内容を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지를 접수할 수 없습니다. 내용을 확인한 후 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można było przyjąć wiadomości. Sprawdź ją i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível aceitar a mensagem. Verifique-a e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение не удалось принять. Проверьте его и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถรับข้อความได้ โปรดตรวจสอบแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj kabul edilemedi. Lütfen kontrol edip tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chấp nhận tin nhắn. Vui lòng kiểm tra và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法接受该消息。请检查后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法接受此訊息。請檢查後再試一次。"
          }
        }
      }
    },
    "The mysql client follows the file's own USE statements: turn on \"Use the database named in the file\" to restore with it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع عميل mysql عبارات USE الموجودة في الملف نفسه: للاستعادة باستخدامه، فعّل \"استخدام قاعدة البيانات المذكورة في الملف\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der mysql-Client folgt den eigenen USE-Anweisungen der Datei: Um mit ihm wiederherzustellen, aktivieren Sie „Die in der Datei genannte Datenbank verwenden“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cliente mysql sigue las propias sentencias USE del archivo: para restaurar con él, activa «Usar la base de datos indicada en el archivo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le client mysql suit les instructions USE du fichier lui-même : pour restaurer avec ce client, activez « Utiliser la base de données nommée dans le fichier »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "mysql क्लाइंट फ़ाइल के अपने USE स्टेटमेंट का पालन करता है: इससे रीस्टोर करने के लिए \"फ़ाइल में बताए गए डेटाबेस का उपयोग करें\" चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klien mysql mengikuti pernyataan USE milik file itu sendiri: untuk memulihkan dengan klien ini, aktifkan \"Gunakan database yang disebut dalam file\"."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il client mysql segue le istruzioni USE del file stesso: per ripristinare con questo client, attiva \"Usa il database indicato nel file\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mysql クライアントはファイル自体の USE 文に従います。このクライアントで復元するには、「ファイルに書かれたデータベースを使う」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "mysql 클라이언트는 파일 자체의 USE 문을 따릅니다. 이 클라이언트로 복원하려면 \"파일에 지정된 데이터베이스 사용\"을 켜세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klient mysql stosuje się do instrukcji USE zawartych w samym pliku: aby przywracać za pomocą tego klienta, włącz „Użyj bazy danych wskazanej w pliku”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cliente mysql segue as próprias instruções USE do arquivo: para restaurar com ele, ative \"Usar o banco de dados indicado no arquivo\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клиент mysql следует операторам USE из самого файла: чтобы восстанавливать с его помощью, включите «Использовать базу данных, указанную в файле»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไคลเอนต์ mysql ทำตามคำสั่ง USE ในไฟล์เอง หากต้องการกู้คืนด้วยไคลเอนต์นี้ ให้เปิด \"ใช้ฐานข้อมูลที่ระบุในไฟล์\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "mysql istemcisi dosyanın kendi USE ifadelerine uyar: onunla geri yüklemek için “Dosyada adı geçen veritabanını kullan” seçeneğini açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình khách mysql làm theo các câu lệnh USE của chính tệp: để khôi phục bằng trình khách này, hãy bật \"Dùng cơ sở dữ liệu ghi trong tệp\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mysql 客户端会遵循文件自身的 USE 语句：要用它恢复，请打开“使用文件中指定的数据库”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mysql 用戶端會遵循檔案本身的 USE 陳述式：若要用它還原，請開啟「使用檔案中指定的資料庫」。"
          }
        }
      }
    },
    "The proxy closed the connection.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق الوكيل الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Proxy hat die Verbindung geschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proxy cerró la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proxy a fermé la connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉक्सी ने कनेक्शन बंद कर दिया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy menutup koneksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il proxy ha chiuso la connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシが接続を閉じました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프록시가 연결을 닫았습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer proxy zamknął połączenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O proxy encerrou a conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокси-сервер закрыл соединение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร็อกซีปิดการเชื่อมต่อแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy bağlantıyı kapattı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy đã đóng kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理服务器关闭了连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理伺服器關閉了連線。"
          }
        }
      }
    },
    "The proxy didn't answer within %lld seconds.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب الوكيل خلال %lld ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Proxy hat nicht innerhalb von %lld Sekunden geantwortet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proxy no respondió en %lld segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proxy n'a pas répondu dans un délai de %lld secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉक्सी ने %lld सेकंड के भीतर जवाब नहीं दिया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy tidak merespons dalam %lld detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il proxy non ha risposto entro %lld secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
