          "stringUnit": {
            "state": "translated",
            "value": "必须至少添加一列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須至少新增一個欄位。"
          }
        }
      }
    },
    "You must map at least one column to import.": {
