    "Collation '%@' does not exist on %@. Replace it with one this server supports.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتيب التجميع '%1$@' غير موجود على %2$@. استبدله بترتيب يدعمه هذا الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kollation „%1$@“ gibt es auf %2$@ nicht. Ersetzen Sie sie durch eine, die dieser Server unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La intercalación '%1$@' no existe en %2$@. Sustitúyala por una que este servidor admita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement « %1$@ » n'existe pas sur %2$@. Remplacez-le par un classement pris en charge par ce serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Collation '%1$@' %2$@ पर मौजूद नहीं है। इसे इस सर्वर द्वारा समर्थित किसी collation से बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Collation '%@' tidak ada di %@. Ganti dengan collation yang didukung server ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La collation '%1$@' non esiste su %2$@. Sostituiscila con una supportata da questo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "照合順序 '%1$@' は %2$@ に存在しません。このサーバーがサポートするものに置き換えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콜레이션 '%1$@'이(가) %2$@에 존재하지 않습니다. 이 서버가 지원하는 콜레이션으로 바꾸세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porządek sortowania „%1$@” nie istnieje na %2$@. Zastąp go takim, który obsługuje ten serwer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O collation '%1$@' não existe em %2$@. Substitua-o por um suportado por este servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр сортировки «%1$@» отсутствует на %2$@. Замените его на поддерживаемый этим сервером."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มี collation '%@' อยู่บน %@ โปรดเปลี่ยนเป็น collation ที่เซิร์ฟเวอร์นี้รองรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@' collation'ı %2$@ sunucusunda yok. Bu sunucunun desteklediği bir collation ile değiştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Collation '%@' không tồn tại trên %@. Hãy thay bằng một collation mà máy chủ này hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排序规则 “%1$@” 在 %2$@ 上不存在。请将其替换为此服务器支持的排序规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定序「%1$@」在 %2$@ 上不存在。請替換為此伺服器支援的定序。"
          }
        }
      }
    },
    "Collation '%@' does not exist on the server you are connected to. Replace it with one this server supports.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتيب التجميع '%@' غير موجود على الخادم المتصل به. استبدله بترتيب يدعمه هذا الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kollation „%@“ gibt es auf dem verbundenen Server nicht. Ersetzen Sie sie durch eine, die dieser Server unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La intercalación '%@' no existe en el servidor al que está conectado. Sustitúyala por una que este servidor admita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement « %@ » n'existe pas sur le serveur auquel vous êtes connecté. Remplacez-le par un classement pris en charge par ce serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Collation '%@' उस सर्वर पर मौजूद नहीं है जिससे आप जुड़े हैं। इसे इस सर्वर द्वारा समर्थित किसी collation से बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Collation '%@' tidak ada di server yang Anda sambungkan. Ganti dengan collation yang didukung server ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La collation '%@' non esiste sul server a cui sei connesso. Sostituiscila con una supportata da questo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "照合順序 '%@' は接続先のサーバーに存在しません。このサーバーがサポートするものに置き換えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콜레이션 '%@'이(가) 연결된 서버에 존재하지 않습니다. 이 서버가 지원하는 콜레이션으로 바꾸세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porządek sortowania „%@” nie istnieje na serwerze, z którym jesteś połączony. Zastąp go takim, który obsługuje ten serwer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O collation '%@' não existe no servidor ao qual você está conectado. Substitua-o por um suportado por este servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр сортировки «%@» отсутствует на сервере, к которому вы подключены. Замените его на поддерживаемый этим сервером."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มี collation '%@' อยู่บนเซิร์ฟเวอร์ที่คุณเชื่อมต่ออยู่ โปรดเปลี่ยนเป็น collation ที่เซิร์ฟเวอร์นี้รองรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' collation'ı bağlı olduğunuz sunucuda yok. Bu sunucunun desteklediği bir collation ile değiştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Collation '%@' không tồn tại trên máy chủ bạn đang kết nối. Hãy thay bằng một collation mà máy chủ này hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排序规则 “%@” 在你连接的服务器上不存在。请将其替换为此服务器支持的排序规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定序「%@」在你所連線的伺服器上不存在。請替換為此伺服器支援的定序。"
          }
        }
      }
