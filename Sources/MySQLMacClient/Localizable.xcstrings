{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "extractionState": "manual"
    },
    "%@": {
      "extractionState": "manual"
    },
    "%@ backs up the whole database: every table, view, routine, trigger and event, read without locking tables, from one consistent snapshot of its InnoDB tables.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يأخذ %@ نسخة احتياطية من قاعدة البيانات بالكامل: كل الجداول والعروض والإجراءات والدوال والمشغّلات والأحداث، مقروءةً دون قفل الجداول، من لقطة واحدة متسقة لجداول InnoDB فيها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sichert die gesamte Datenbank: alle Tabellen, Ansichten, Routinen, Trigger und Ereignisse, gelesen, ohne Tabellen zu sperren, aus einem einzigen konsistenten Snapshot ihrer InnoDB-Tabellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hace una copia de seguridad de toda la base de datos: todas las tablas, vistas, rutinas, disparadores y eventos, leídos sin bloquear las tablas, a partir de una única instantánea coherente de sus tablas InnoDB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sauvegarde toute la base de données : toutes les tables, vues, routines, triggers et événements, lus sans verrouiller les tables, depuis un seul instantané cohérent de ses tables InnoDB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पूरे डेटाबेस का बैकअप लेता है: हर टेबल, व्यू, रूटीन, ट्रिगर और इवेंट, जिन्हें टेबल लॉक किए बिना, उसकी InnoDB टेबलों के एक ही सुसंगत स्नैपशॉट से पढ़ा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mencadangkan seluruh database: semua tabel, view, prosedur, fungsi, trigger, dan event, dibaca tanpa mengunci tabel, dari satu snapshot yang konsisten dari tabel InnoDB-nya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esegue il backup dell'intero database: tutte le tabelle, viste, routine, trigger ed eventi, letti senza bloccare le tabelle, da un unico snapshot coerente delle sue tabelle InnoDB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はデータベース全体をバックアップします。すべてのテーブル、ビュー、ルーチン、トリガー、イベントを、テーブルをロックせずに、InnoDB テーブルを対象とした一貫性のある 1 つのスナップショットから読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 데이터베이스 전체를 백업합니다. 모든 테이블, 뷰, 루틴, 트리거, 이벤트를 테이블을 잠그지 않고, InnoDB 테이블의 일관된 하나의 스냅샷에서 읽습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tworzy kopię zapasową całej bazy danych: wszystkich tabel, widoków, procedur, funkcji, wyzwalaczy i zdarzeń, odczytanych bez blokowania tabel z jednej spójnej migawki jej tabel InnoDB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ faz o backup do banco de dados inteiro: todas as tabelas, views, rotinas, triggers e eventos, lidos sem bloquear tabelas, de um único snapshot consistente das suas tabelas InnoDB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ создаёт резервную копию всей базы данных: всех таблиц, представлений, процедур, функций, триггеров и событий, прочитанных без блокировки таблиц из одного согласованного снимка её таблиц InnoDB."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ สำรองข้อมูลทั้งฐานข้อมูล ทั้งตาราง มุมมอง รูทีน ทริกเกอร์ และอีเวนต์ทั้งหมด โดยไม่ล็อกตาราง และอ่านจากสแนปช็อตเดียวที่สอดคล้องกันของตาราง InnoDB ในฐานข้อมูลนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ veritabanının tamamını yedekler: tüm tabloları, view'ları, procedure ve function'ları, trigger'ları ve event'leri tabloları kilitlemeden, InnoDB tablolarının tek bir tutarlı anlık görüntüsünden okur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sao lưu toàn bộ cơ sở dữ liệu: mọi bảng, khung nhìn, thủ tục, hàm, trình kích hoạt và sự kiện, được đọc mà không khóa bảng, từ cùng một ảnh chụp nhất quán của các bảng InnoDB trong đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会备份整个数据库：所有表、视图、例程、触发器和事件，均在不锁定表的情况下，从其 InnoDB 表的同一个一致快照中读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會備份整個資料庫：所有表格、檢視表、常式、觸發器和事件，皆在不鎖定表格的情況下，從其 InnoDB 表格的同一個一致快照讀取。"
          }
        }
      }
    },
    "%@ failed with exit status %lld.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل %@ برمز الخروج %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist mit dem Exit-Status %lld fehlgeschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ falló con el código de salida %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a échoué avec le code de sortie %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ एग्ज़िट स्टेटस %lld के साथ विफल रहा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gagal dengan status keluar %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è riuscito (codice di uscita %lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は終了ステータス %lld で失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 실패했습니다(종료 상태 %lld)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zakończył działanie z błędem (kod wyjścia %lld)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ falhou com o código de saída %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ завершился с ошибкой (код выхода %lld)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ล้มเหลวด้วยสถานะการออก %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %lld çıkış koduyla başarısız oldu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ thất bại với mã thoát %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 失败，退出状态为 %lld。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 失敗，結束狀態為 %lld。"
          }
        }
      }
    },
    "%@ has no option to insist on an encrypted connection, so it could connect unencrypted. Use the built-in engine for this connection.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يملك %@ خيارًا يفرض اتصالًا مشفّرًا، لذا قد يتصل دون تشفير. استخدم المحرك المدمج لهذا الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat keine Option, eine verschlüsselte Verbindung zu erzwingen, und könnte sich daher unverschlüsselt verbinden. Verwenden Sie für diese Verbindung die integrierte Engine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene ninguna opción para exigir una conexión cifrada, así que podría conectarse sin cifrar. Usa el motor integrado para esta conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas d'option pour exiger une connexion chiffrée et pourrait donc se connecter sans chiffrement. Utilisez le moteur intégré pour cette connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में एन्क्रिप्टेड कनेक्शन को अनिवार्य करने का कोई विकल्प नहीं है, इसलिए वह बिना एन्क्रिप्शन के कनेक्ट हो सकता है। इस कनेक्शन के लिए बिल्ट-इन इंजन का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak memiliki opsi untuk mewajibkan koneksi terenkripsi, sehingga bisa tersambung tanpa enkripsi. Gunakan mesin bawaan untuk koneksi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha un'opzione per imporre una connessione cifrata, quindi potrebbe connettersi senza crittografia. Usa il motore integrato per questa connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ には暗号化接続を必須にするオプションがないため、暗号化されずに接続する可能性があります。この接続には内蔵エンジンを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 암호화된 연결을 강제하는 옵션이 없어 암호화되지 않은 채로 연결될 수 있습니다. 이 연결에는 내장 엔진을 사용하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie ma opcji wymuszającej szyfrowane połączenie, więc mógłby połączyć się bez szyfrowania. Użyj dla tego połączenia wbudowanego silnika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem opção para exigir uma conexão criptografada, então pode se conectar sem criptografia. Use o mecanismo integrado para esta conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ нет параметра, требующего зашифрованного соединения, поэтому он может подключиться без шифрования. Используйте для этого подключения встроенный механизм."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่มีตัวเลือกที่บังคับให้ใช้การเชื่อมต่อแบบเข้ารหัส จึงอาจเชื่อมต่อโดยไม่เข้ารหัส โปรดใช้เอนจินในตัวสำหรับการเชื่อมต่อนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ şifreli bağlantıyı zorunlu kılacak bir seçeneğe sahip değil, bu yüzden şifresiz bağlanabilir. Bu bağlantı için yerleşik motoru kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không có tùy chọn bắt buộc kết nối mã hóa, nên có thể kết nối mà không mã hóa. Hãy dùng công cụ tích hợp sẵn cho kết nối này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有强制使用加密连接的选项，因此可能以未加密方式连接。请为此连接使用内置引擎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有強制使用加密連線的選項，因此可能以未加密方式連線。請為此連線使用內建引擎。"
          }
        }
      }
    },
    "%@ reported %lld failed statements; it restored every other statement. Its first 100 messages:\n%@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبلغ %@ عن %lld عبارة فاشلة؛ تمت استعادة كل العبارات الأخرى. أول 100 من رسائله:\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat %lld fehlgeschlagene Anweisungen gemeldet; alle anderen Anweisungen wurden wiederhergestellt. Die ersten 100 Meldungen:\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ informó de %lld sentencias fallidas; todas las demás sentencias se restauraron. Sus primeros 100 mensajes:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a signalé %lld instructions en échec ; toutes les autres instructions ont été restaurées. Ses 100 premiers messages :\n%@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने %lld विफल स्टेटमेंट बताए; बाकी सभी स्टेटमेंट रीस्टोर हो गए। उसके पहले 100 संदेश:\n%@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ melaporkan %lld pernyataan gagal; semua pernyataan lain telah dipulihkan. 100 pesan pertamanya:\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha segnalato %lld istruzioni non riuscite; tutte le altre istruzioni sono state ripristinate. I suoi primi 100 messaggi:\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %lld 件の文が失敗したと報告しました。その他の文はすべて復元されています。最初の 100 件のメッセージ:\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 실패한 문 %lld개를 보고했습니다. 나머지 문은 모두 복원되었습니다. 처음 100개 메시지:\n%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zgłosił nieudane instrukcje (%lld); wszystkie pozostałe instrukcje zostały przywrócone. Pierwsze 100 komunikatów:\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ relatou %lld instruções com falha; todas as outras instruções foram restauradas. Suas primeiras 100 mensagens:\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ сообщил о неудачных операторах (%lld); все остальные операторы восстановлены. Первые 100 сообщений:\n%@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ รายงานว่ามี %lld คำสั่งที่ล้มเหลว คำสั่งอื่นทั้งหมดถูกกู้คืนแล้ว ข้อความ 100 รายการแรก:\n%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %lld başarısız ifade bildirdi; diğer tüm ifadeler geri yüklendi. İlk 100 mesaj:\n%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã báo %lld câu lệnh lỗi; mọi câu lệnh khác đã được khôi phục. 100 thông báo đầu tiên:\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 报告有 %lld 条语句失败；其他所有语句均已恢复。前 100 条消息：\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 回報有 %lld 個陳述式失敗；其他所有陳述式皆已還原。前 100 則訊息：\n%@"
          }
        }
      }
    },
    "%@ reported errors; it restored every other statement:\n%@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبلغ %@ عن أخطاء؛ تمت استعادة كل العبارات الأخرى:\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat Fehler gemeldet; alle anderen Anweisungen wurden wiederhergestellt:\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ informó de errores; todas las demás sentencias se restauraron:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a signalé des erreurs ; toutes les autres instructions ont été restaurées :\n%@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने त्रुटियाँ बताईं; बाकी सभी स्टेटमेंट रीस्टोर हो गए:\n%@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ melaporkan galat; semua pernyataan lain telah dipulihkan:\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha segnalato errori; tutte le altre istruzioni sono state ripristinate:\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がエラーを報告しました。その他の文はすべて復元されています:\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 오류를 보고했습니다. 나머지 문은 모두 복원되었습니다:\n%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zgłosił błędy; wszystkie pozostałe instrukcje zostały przywrócone:\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ relatou erros; todas as outras instruções foram restauradas:\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ сообщил об ошибках; все остальные операторы восстановлены:\n%@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ รายงานข้อผิดพลาด คำสั่งอื่นทั้งหมดถูกกู้คืนแล้ว:\n%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hata bildirdi; diğer tüm ifadeler geri yüklendi:\n%@"
          }
        },
        "vi": {
